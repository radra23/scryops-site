#!/bin/sh
# .githooks/pre-commit
#
# Blocks commits that introduce:
#   - unknown or incorrectly-cased tags
#   - broken article visuals (missing shortcode file, malformed SVG/HTML)
#
# Activate once with:
#   git config core.hooksPath .githooks
#
# verify_visuals.py runs the visual checks AND the tag check (normalize-tags.py),
# so this one command covers both. OTel-correctness hits are warnings only and do
# not block the commit.

if ! python3 scripts/verify_visuals.py; then
  echo ""
  echo "  pre-commit checks failed (see above)."
  echo "  Tag casing auto-fix:  python3 scripts/normalize-tags.py --fix && git add -u"
  echo "  Bypass once:          git commit --no-verify"
  exit 1
fi
